# ── Order submission (Step 3) ─────────────────────────────────────────────
# Orders are sent to the manager by email (Web3Forms) AND Telegram. No online
# payment. Copy this file to `.env` and fill in. Never commit `.env`.

# Web3Forms access key — create a form at https://web3forms.com targeting ok@drkaholi.com
# TODO(client): provide Web3Forms access key
WEB3FORMS_ACCESS_KEY=

# Telegram bot that messages the manager with each order
# TODO(client): provide bot token (from @BotFather) and the manager chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where the email order lands (kept here so it is configurable, not hardcoded)
ORDER_EMAIL_TO=ok@drkaholi.com
