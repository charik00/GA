---
import '../styles/base.css';
import '../styles/shell.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import MobileNav from '../components/MobileNav.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'philosophy' | 'about' | 'products' | 'kits' | 'articles' | 'contact';
  mobileActive?: 'home' | 'products' | 'kits';
  locale?: Locale;
  /** landing's hero already clears the fixed header; content pages need a top offset */
  padTop?: boolean;
}
const {
  title = 'Genetic Analyze',
  description = 'Whole-plant formulas, built the way nature intended. Over 50 years of clinical practice and 5,000 years of Chinese pharmacology.',
  active,
  mobileActive,
  locale = 'en',
  padTop = true,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#232323" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Montserrat:wght@200;300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header active={active} locale={locale} />
    <main class={padTop ? 'page-shell page-shell--pad' : 'page-shell'}>
      <slot />
    </main>
    <Footer locale={locale} />

    <CookieConsent locale={locale} />
    <MobileNav active={mobileActive} locale={locale} />
    <CartDrawer locale={locale} />
  </body>
</html>
