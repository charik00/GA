---
import Layout from '../layouts/Layout.astro';
import '../styles/blocks/ga-faq-style.css';
import '../styles/blocks/ga-doc-style.css';
import '../styles/blocks/ga-legal-style.css';
import '../styles/blocks/ga-shop-page-style.css';
import '../styles/pages/checkout.css';
import html from '../content/checkout.html?raw';
import js from '../scripts/checkout.js?raw';
const title = 'Checkout, Genetic Analyze';
---

<Layout title={title}>
  <Fragment set:html={html} />
  <script is:inline set:html={js} />
  <script>import '../scripts/checkout-logic.ts';</script>
</Layout>
