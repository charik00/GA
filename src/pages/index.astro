---
import Layout from '../layouts/Layout.astro';
import '../styles/landing.css';
import { products, kits, articles } from '../data/catalog';
import { useTranslations } from '../i18n';
const t = useTranslations('en');
---

<Layout title="GA, Genetic Analyze" active="home" mobileActive="home" padTop={false}>
  <!-- ============== HERO ============== -->
  <section class="hero" id="home" data-screen-label="01 Hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="hero-eyebrow eyebrow">{t('hero.eyebrow')}</div>
      <h1 class="h-display">
        <span>{t('hero.title.a')}</span><br />
        <span class="em italic" set:html={t('hero.title.b').replace(/\s(\S+)$/, '&nbsp;$1')} />
      </h1>
      <p class="hero-sub">{t('hero.sub')}</p>
      <div class="hero-actions">
        <a href="#products" class="btn solid">{t('hero.cta1')}<span class="arrow"></span></a>
        <a href="#philosophy" class="btn ghost">{t('hero.cta2')}</a>
      </div>
      <div class="hero-trust" aria-label="Credentials">
        <span>{t('hero.trust.1')}</span><span class="dot" aria-hidden="true">·</span>
        <span>{t('hero.trust.2')}</span><span class="dot" aria-hidden="true">·</span>
        <span>{t('hero.trust.3')}</span><span class="dot" aria-hidden="true">·</span>
        <span>{t('hero.trust.4')}</span>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-stage">
        <div class="hero-capsule-wrap">
          <img class="hero-capsule-photo" src="/hero-stilllife-v14.png" alt="Horizontal band of botanical ingredients on natural linen, soft leaf shadows above" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============== TRUST ============== -->
  <section class="trust" data-screen-label="02 Trust">
    <div class="wrap">
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-icon"><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><circle cx="14" cy="14" r="11"/><path d="M14 7v7l4 3"/></svg></span>
          <div class="trust-label">{t('trust.t1')}</div>
        </div>
        <div class="trust-item">
          <span class="trust-icon"><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M14 4c4 3 4 6 4 9a4 4 0 1 1-8 0c0-3 0-6 4-9z"/><path d="M10 17c0 4 2 7 4 7s4-3 4-7"/></svg></span>
          <div class="trust-label">{t('trust.t2')}</div>
        </div>
        <div class="trust-item">
          <span class="trust-icon"><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M14 3l3 3 4-1-1 4 3 3-3 3 1 4-4-1-3 3-3-3-4 1 1-4-3-3 3-3-1-4 4 1z"/></svg></span>
          <div class="trust-label">{t('trust.t3')}</div>
        </div>
        <div class="trust-item">
          <span class="trust-icon"><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M5 22V10l9-5 9 5v12"/><path d="M5 22h18"/><path d="M10 22v-7h8v7"/></svg></span>
          <div class="trust-label">{t('trust.t4')}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== FOR WHOM ============== -->
  <section class="section" id="forwhom" data-screen-label="03 For Whom">
    <div class="wrap">
      <div class="forwhom">
        <div>
          <span class="section-num">{t('forwhom.num')}</span>
          <h2 class="h-section">
            <span>{t('forwhom.title.a')}</span><br />
            <span class="em honey">{t('forwhom.title.b')}</span>
          </h2>
        </div>
        <div class="forwhom-body"><p>{t('forwhom.body1')}</p></div>
      </div>
    </div>
  </section>

  <!-- ============== PHILOSOPHY ============== -->
  <section class="section" id="philosophy" data-screen-label="05 Philosophy">
    <div class="wrap">
      <div class="section-head center">
        <span class="section-num">{t('phil.num')}</span>
        <h2 class="h-section">
          <span>{t('phil.title.a')}</span><br />
          <span class="italic honey">{t('phil.title.b')}</span>
        </h2>
      </div>
      <div class="phil-grid">
        <article class="phil-card"><div class="phil-num">{t('phil.c1.n')}</div><h3>{t('phil.c1.t')}</h3><p>{t('phil.c1.b')}</p></article>
        <article class="phil-card"><div class="phil-num">{t('phil.c2.n')}</div><h3>{t('phil.c2.t')}</h3><p>{t('phil.c2.b')}</p></article>
        <article class="phil-card"><div class="phil-num">{t('phil.c3.n')}</div><h3>{t('phil.c3.t')}</h3><p>{t('phil.c3.b')}</p></article>
      </div>
      <div class="cat-bottom" style="margin-top:56px">
        <a href="/philosophy" class="btn">{t('phil.full')}<span class="arrow"></span></a>
      </div>
    </div>
  </section>

  <!-- ============== CATALOG ============== -->
  <section class="section" id="products" data-screen-label="06 Catalog" style="padding-top:40px">
    <div class="wrap">
      <div class="section-head" style="display:flex; justify-content:space-between; align-items:end; gap:40px; flex-wrap:wrap; margin-bottom:80px">
        <div>
          <span class="section-num">{t('cat.num')}</span>
          <h2 class="h-section"><span>{t('cat.title.a')}</span> <span class="italic honey">{t('cat.title.b')}</span></h2>
        </div>
      </div>
      <div class="cat-grid" id="cat-grid">
        {products.map((p) => (
          <article class="cat-card" data-slug={p.slug} data-name={p.name} style="cursor:pointer">
            <div class="cat-bottle"><img class="cat-bottle-photo" src={`/${p.img}`} alt={p.name} /></div>
            <div class="cat-meta">
              <div class="cat-sku">{p.sku}</div>
              <div class="cat-name">{p.name}</div>
              <div class="cat-bar" style={`background:${p.color}`}></div>
              <div class="cat-slogan" style="font-style:normal; text-transform:uppercase; letter-spacing:0.18em; font-size:11px; color:var(--fg-3); min-height:0; margin-bottom:6px">{p.subtitle}</div>
              <div class="cat-slogan">{p.slogan}</div>
            </div>
            <div class="cat-foot">
              <span class="price">{p.price ?? ''}</span>
              <a class="add" href={`/products?item=${encodeURIComponent(p.name)}`} aria-label={`Learn more about ${p.name}`}>{t('cat.learn')}</a>
            </div>
          </article>
        ))}
      </div>
      <div class="cat-bottom">
        <a href="/products" class="btn">{t('cat.all')}<span class="arrow"></span></a>
      </div>
    </div>
  </section>

  <!-- ============== BEFORE / AFTER BAND ============== -->
  <section class="ba-band" data-screen-label="06b Before/After Band">
    <div class="ba-band__grid">
      <span class="e left">{t('ba.before')}</span>
      <div class="ba-band__lines">
        <div class="ba-band__line before">{t('ba.before.line')}</div>
        <div class="ba-band__line after">{t('ba.after.line')}</div>
      </div>
      <span class="e right">{t('ba.after')}</span>
    </div>
  </section>

  <!-- ============== KITS ============== -->
  <section class="kits" id="kits" data-screen-label="07 Kits">
    <div class="wrap">
      <div class="section-head center" style="position:relative; z-index:2">
        <span class="section-num">{t('kits.num')}</span>
        <h2 class="h-section" style="max-width:1000px; margin-left:auto; margin-right:auto">
          <span>{t('kits.title.a')}</span><br />
          <span class="italic honey">{t('kits.title.b')}</span>
        </h2>
        <p class="muted" style="max-width:640px; margin:24px auto 0; text-align:center; position:relative; z-index:2">{t('kits.sub')}</p>
      </div>
      <div class="kits-grid" id="kits-grid">
        {kits.map((k) => (
          <article class="kit">
            <div class="kit-body">
              <h3>{k.name}</h3>
              <p class="kit-slogan">{k.slogan}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="cat-bottom" style="position:relative; z-index:2">
        <a href="/kits" class="btn">{t('kits.all')}<span class="arrow"></span></a>
      </div>
    </div>
  </section>

  <!-- ============== ARTICLES ============== -->
  <section class="section" id="articles" data-screen-label="09 Articles" style="border-top:1px solid var(--line)">
    <div class="wrap">
      <div class="art-head">
        <span class="section-num">{t('art.num')}</span>
        <h2 class="art-title"><span>{t('art.title.a')}</span> <span class="italic">{t('art.title.b')}</span></h2>
        <p class="art-sub">{t('art.sub')}</p>
      </div>
      <div class="art-layout">
        <div class="art-cards">
          {articles.map((a, i) => (
            <article class={`art-card art-card--${i + 1}`}>
              <div class="art-card__top">
                <span class="art-eyebrow">{a.eyebrow}</span>
                <h3>{a.title}</h3>
                <p>{a.excerpt}</p>
              </div>
              <div class="art-card__foot">
                <span class="art-time">{a.time}</span>
                <a href={a.href} class="art-read">{t('art.read')}<span class="arrow"></span></a>
              </div>
            </article>
          ))}
        </div>
        <figure class="art-photo-wrap">
          <img class="art-photo" src="/images/articles-model.jpg" alt="Woman holding a single GA capsule beside a bottle of Stomavil" />
        </figure>
      </div>
    </div>
  </section>

  <!-- ============== FINAL CTA ============== -->
  <section class="final-cta" id="contact" data-screen-label="10 Final CTA">
    <div class="inner">
      <span class="section-num" style="margin-bottom:32px">{t('cta.num')}</span>
      <h2 class="h-display">
        <span class="em italic">{t('cta.title.a')}</span> <span class="em italic">{t('cta.title.b')}</span>
      </h2>
      <p class="final-cta-sub">{t('cta.sub')}</p>
      <div class="final-cta-actions">
        <a href="#products" class="btn solid">{t('cta.b1')}<span class="arrow"></span></a>
        <a href="/contact" class="btn">{t('cta.b2')}</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // In-page smooth scroll for hero/CTA anchors (landing only)
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      const top = target.getBoundingClientRect().top + window.scrollY - 60;
      window.scrollTo({ top, behavior: 'smooth' });
    });
  });

  // Clicking a formula bottle on Home opens that formula's quick-view on Products
  document.querySelectorAll<HTMLElement>('.cat-card[data-name]').forEach((card) => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return; // let the Learn More link handle itself
      const name = card.getAttribute('data-name')!;
      window.location.href = '/products?item=' + encodeURIComponent(name);
    });
  });
</script>
